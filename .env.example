# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pcc"
# Set to "true" only behind HTTPS (forces Secure cookies). Defaults to NODE_ENV=production.
# COOKIE_SECURE=true
# Comma-separated extra origins allowed to make mutating API calls (CSRF origin check).
# ALLOWED_ORIGINS=https://pcc.example.com

# ─── File storage (Phase 3) ───
# "local" (filesystem, dev/single node) or "s3" (any S3-compatible service).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# HMAC secret for local signed download URLs (≥ 32 chars). Required in production with STORAGE_DRIVER=local.
# STORAGE_SIGNING_SECRET=
# S3_BUCKET=pcc-documents
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=25
SIGNED_URL_TTL_SECONDS=300
